<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= error.status %> - Error</title>
    <link rel="stylesheet" href="/css/styles.css">
  </head>
  <body>
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <div class="error-template">
            <h1><%= error.status %></h1>
            <h2><%= error.message %></h2>
            <div class="error-details">
              <pre><%= error.stack %></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

